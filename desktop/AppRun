#!/usr/bin/env bash
set -euo pipefail
# Use our own entry point: electron-builder's generated AppRun adds --no-sandbox
# when user namespaces are restricted, even when executableArgs is empty.
if [[ -n "${APPIMAGE_EXIT_AFTER_INSTALL:-}" ]]; then exit 0; fi
game_app_dir="${APPDIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"
export LD_LIBRARY_PATH="$game_app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$game_app_dir/deep-dark-dungeons-hol" "$@"
