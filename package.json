{
  "name": "deep-dark-dungeons-hol",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "A four-hero Heroes of Legend dungeon RPG",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:visual": "node scripts/visual-check.mjs",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never -c.productName=deep-dark-dungeons-hol",
    "package:windows": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:play": "node scripts/play-check.mjs",
    "test:native": "node scripts/native-check.mjs",
    "test:controls": "node scripts/control-check.mjs",
    "coverage:abilities": "node scripts/ability-coverage.mjs",
    "package:dir": "npm run build && electron-builder --linux dir --publish never"
  },
  "build": {
    "appId": "com.bruceamoser.deepdarkdungeons",
    "productName": "Deep Dark Dungeons - HoL",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "executableName": "deep-dark-dungeons-hol",
      "desktop": {
        "entry": {
          "Name": "Deep Dark Dungeons - HoL"
        }
      },
      "maintainer": "Bruce A. Moser <bruceamoser@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "icon": "public/art/greyhaven-seal.png",
    "afterPack": "scripts/after-pack.cjs",
    "artifactName": "Deep-Dark-Dungeons-HoL-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "bruceamoser",
      "repo": "Deep-Dark-Dungeons-HoL",
      "releaseType": "release"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "appImage": {
      "executableArgs": []
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Deep-Dark-Dungeons-HoL-Setup-${version}-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": "desktop/deb-after-install.sh",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2 | libasound2t64",
        "pkexec"
      ],
      "artifactName": "Deep-Dark-Dungeons-HoL-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "prettier": "3.9.10",
    "vite": "8.3.6"
  },
  "author": "Bruce A. Moser",
  "repository": {
    "type": "git",
    "url": "https://github.com/bruceamoser/Deep-Dark-Dungeons-HoL.git"
  }
}
